{
  "expo": {
    "name": "Coop+",
    "slug": "coop-plus",
    "scheme": "coopplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#CFD91A",
      "resizeMode": "contain"
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Coop+ uses the local network to find and connect to your Smart Coop Defender on Wi-Fi.",
        "NSBonjourServices": [
          "_http._tcp",
          "_coop-plus._tcp"
        ]
      }
    },
    "android": {
      "package": "com.coopplus.app",
      "usesCleartextTraffic": true,
      "networkSecurityConfig": "./network_security_config.xml",
      "adaptiveIcon": {
        "backgroundColor": "#CFD91A"
      }
    },
    "plugins": [
      "expo-font",
      "./withCleartext.js"
    ],
    "extra": {
      "eas": {
        "projectId": "a82e6316-9c77-4d72-923e-adbc993408ec"
      }
    },
    "owner": "admin1236776efue5"
  }
}
