// ==========================================================
// SMART COOP PREDATOR DETERRENT — ENCLOSURE v6
// Redesigned with interlocking lid, filleted outer geometry,
// and modular mounting for ESP32, 8x8 NeoPixel, PIR, Servo, LDR.
// ==========================================================

$fn = 60; // Render resolution

// ---------- RENDER SELECTOR ----------
// Change to "box" or "lid" to preview/export each part.
part = "all"; // "box", "lid", or "all" (for assembly preview)

// ---------- OVERALL BOX DIMENSIONS ----------
wall          = 3.0;    // Heavy-duty outdoor wall thickness (mm)
floor_t       = 3.2;    // Floor panel thickness (mm)
box_w         = 165.0;  // Exterior width  (X)
box_d         = 115.0;  // Exterior depth  (Y)
box_h         = 92.0;   // Exterior height (Z)
fillet_r      = 6.0;    // Corner outer fillet radius

// ---------- LID & INTERLOCK RING ----------
lid_t         = 3.2;    // Lid top thickness
lid_hole_d    = 3.4;    // Clearance hole for M3 screws
lip_h         = 3.5;    // Interlocking lip height
lip_clearance = 0.25;   // Fit tolerance gap

// ---------- CORNER MOUNTING BOSSES ----------
boss_inset    = 12.0;   // Inset from corner centers
boss_od       = 9.5;    // Boss outer diameter
boss_pilot_d  = 2.6;    // Pilot hole for self-tapping M3 screw
boss_depth    = 12.0;   // Screw hole depth

corner_positions = [
    [boss_inset, boss_inset],
    [box_w - boss_inset, boss_inset],
    [boss_inset, box_d - boss_inset],
    [box_w - boss_inset, box_d - boss_inset]
];

// ---------- HARDWARE COMPONENT PARAMETERS ----------
// ESP32 DevKit-C V4
esp_w = 55.0; esp_d = 28.0; esp_hole_spacing = 48.0;
esp_standoff_h = 6.0; esp_standoff_od = 6.5; esp_pilot_d = 2.2;
esp_x0 = box_w - wall - 15.0 - esp_w;
esp_y0 = box_d - wall - 12.0 - esp_d;

// 8x8 NeoPixel Matrix
matrix_active_w = 64.0; matrix_active_h = 64.0;
matrix_hole_spacing = 58.0; matrix_standoff_depth = 5.0;
matrix_cx = box_w / 2; matrix_cz = 56.0;

// PIR Sensor
pir_dome_d = 24.0; pir_hole_spacing = 28.0; pir_standoff_depth = 5.0;
pir_cx = box_w / 2; pir_cz = 18.0;

// Status LEDs & Buzzer
led_hole_d = 5.35; led_red_x = pir_cx - 36.0; led_grn_x = pir_cx + 36.0;
buzzer_cx = pir_cx + 62.0; buzzer_cz = pir_cz;

// Top Controls (Manual Button & LDR)
button_hole_d = 12.2; button_cx = 32.0; button_cy = 25.0;
ldr_window_d = 6.0; ldr_cx = box_w - 32.0; ldr_cy = 25.0;

// SG90 Servo
servo_shaft_d = 16.0; servo_cy = 32.0; servo_cz = 22.0;

// ==========================================================
// HELPER MODULES
// ==========================================================

module rounded_cube(w, d, h, r) {
    hull() {
        translate([r, r, 0]) cylinder(r=r, h=h);
        translate([w-r, r, 0]) cylinder(r=r, h=h);
        translate([r, d-r, 0]) cylinder(r=r, h=h);
        translate([w-r, d-r, 0]) cylinder(r=r, h=h);
    }
}

// ==========================================================
// ENCLOSURE BASE TRAY
// ==========================================================

module base_box() {
    difference() {
        union() {
            // Main Outer Shell
            rounded_cube(box_w, box_d, box_h, fillet_r);

            // Back Mounting Tabs
            for (tx = [box_w * 0.25, box_w * 0.75]) {
                translate([tx - 10, box_d, box_h / 2 - 10])
                    cube([20, 6, 20]);
            }

            // Corner Bosses
            for (p = corner_positions) {
                translate([p[0], p[1], floor_t])
                    cylinder(h = box_h - floor_t, d = boss_od);
            }

            // ESP32 Standoffs
            translate([esp_x0 + (esp_w - esp_hole_spacing)/2, esp_y0 + esp_d/2, floor_t])
                cylinder(h = esp_standoff_h, d = esp_standoff_od);
            translate([esp_x0 + (esp_w + esp_hole_spacing)/2, esp_y0 + esp_d/2, floor_t])
                cylinder(h = esp_standoff_h, d = esp_standoff_od);

            // Matrix Standoffs
            for (dx = [-matrix_hole_spacing/2, matrix_hole_spacing/2])
                for (dz = [-matrix_hole_spacing/2, matrix_hole_spacing/2])
                    translate([matrix_cx + dx, wall, matrix_cz + dz])
                        rotate([-90,0,0]) cylinder(h = matrix_standoff_depth, d = 6.5);

            // PIR Standoffs
            for (dx = [-pir_hole_spacing/2, pir_hole_spacing/2])
                translate([pir_cx + dx, wall, pir_cz])
                    rotate([-90,0,0]) cylinder(h = pir_standoff_depth, d = 6.5);
        }

        // Inner Hollow Cavity
        translate([wall, wall, floor_t])
            rounded_cube(box_w - 2*wall, box_d - 2*wall, box_h, max(1, fillet_r - wall));

        // Interlocking Rim Step for Lid
        translate([wall - lip_clearance, wall - lip_clearance, box_h - lip_h])
            rounded_cube(box_w - 2*wall + 2*lip_clearance, box_d - 2*wall + 2*lip_clearance, lip_h + 1, fillet_r - wall);

        // Corner Boss Pilot Holes
        for (p = corner_positions) {
            translate([p[0], p[1], box_h - boss_depth])
                cylinder(h = boss_depth + 1, d = boss_pilot_d);
        }

        // ESP32 Standoff Pilot Holes
        translate([esp_x0 + (esp_w - esp_hole_spacing)/2, esp_y0 + esp_d/2, floor_t])
            cylinder(h = esp_standoff_h + 1, d = 2.2);
        translate([esp_x0 + (esp_w + esp_hole_spacing)/2, esp_y0 + esp_d/2, floor_t])
            cylinder(h = esp_standoff_h + 1, d = 2.2);

        // Front Cutouts (Matrix Window, PIR, LEDs, Buzzer)
        translate([matrix_cx - matrix_active_w/2, -1, matrix_cz - matrix_active_h/2])
            cube([matrix_active_w, wall + 2, matrix_active_h]);

        translate([pir_cx, -1, pir_cz]) rotate([-90,0,0]) cylinder(h = wall + 2, d = pir_dome_d);
        translate([led_red_x, -1, pir_cz]) rotate([-90,0,0]) cylinder(h = wall + 2, d = led_hole_d);
        translate([led_grn_x, -1, pir_cz]) rotate([-90,0,0]) cylinder(h = wall + 2, d = led_hole_d);

        for (i = [0:5]) {
            ang = i * 60;
            translate([buzzer_cx + 5 * cos(ang), -1, buzzer_cz + 5 * sin(ang)])
                rotate([-90,0,0]) cylinder(h = wall + 2, d = 1.8);
        }

        // Right USB Port Slot
        translate([box_w - wall - 1, esp_y0 + esp_d/2 - 7, floor_t + esp_standoff_h + 3])
            cube([wall + 3, 14, 9]);

        // Left Servo Shaft Hole
        translate([-1, servo_cy, servo_cz]) rotate([0,90,0]) cylinder(h = wall + 2, d = servo_shaft_d);

        // Back Mounting Tab Screw Holes
        for (tx = [box_w * 0.25, box_w * 0.75]) {
            translate([tx, box_d + 3, box_h / 2])
                rotate([90,0,0]) cylinder(h = 8, d = 4.5);
        }
    }
}

// ==========================================================
// TOP LID COVER
// ==========================================================

module top_lid() {
    union() {
        difference() {
            // Main Lid Plate
            rounded_cube(box_w, box_d, lid_t, fillet_r);

            // M3 Mounting Screw Holes
            for (p = corner_positions) {
                translate([p[0], p[1], -1])
                    cylinder(h = lid_t + 2, d = lid_hole_d);
            }

            // Top Panel Apertures (Manual Button & LDR Window)
            translate([button_cx, button_cy, -1]) cylinder(h = lid_t + 2, d = button_hole_d);
            translate([ldr_cx, ldr_cy, -1]) cylinder(h = lid_t + 2, d = ldr_window_d);
        }

        // Bottom Interlocking Alignment Lip
        translate([0, 0, -lip_h]) {
            difference() {
                translate([wall + lip_clearance, wall + lip_clearance, 0])
                    rounded_cube(box_w - 2*(wall + lip_clearance), box_d - 2*(wall + lip_clearance), lip_h, fillet_r - wall);
                
                translate([wall + 2.5, wall + 2.5, -1])
                    rounded_cube(box_w - 2*(wall + 2.5), box_d - 2*(wall + 2.5), lip_h + 2, max(1, fillet_r - wall - 2.5));

                // Clear Screw Boss Locations
                for (p = corner_positions) {
                    translate([p[0], p[1], -1])
                        cylinder(h = lip_h + 2, d = boss_od + 1.0);
                }
            }
        }
    }
}

// ==========================================================
// RENDER EXECUTION
// ==========================================================

if (part == "box") {
    base_box();
} else if (part == "lid") {
    top_lid();
} else if (part == "all") {
    base_box();
    translate([0, 0, box_h + 15]) // Raised preview position
        top_lid();
}
