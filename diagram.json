{
  "version": 1,
  "author": "Smart Coop Hardware Team",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 20, "left": 0, "attrs": {} },

    {
      "type": "wokwi-neopixel-canvas",
      "id": "matrix1",
      "top": -260,
      "left": -20,
      "attrs": { "rows": "8", "cols": "8", "pixelate": "1" }
    },

    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": -140,
      "left": -320,
      "attrs": {}
    },

    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 60,
      "left": -320,
      "attrs": {}
    },

    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 220,
      "left": -320,
      "attrs": { "color": "green", "xray": "1" }
    },

    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": -140,
      "left": 320,
      "attrs": { "volume": "0.1" }
    },

    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 60,
      "left": 340,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 100,
      "left": 260,
      "attrs": { "value": "220" }
    },

    {
      "type": "wokwi-led",
      "id": "led2",
      "top": 160,
      "left": 340,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 200,
      "left": 260,
      "attrs": { "value": "220" }
    },

    {
      "type": "wokwi-servo-motor",
      "id": "servo1",
      "top": 260,
      "left": 320,
      "attrs": { "horn": "single" }
    }
  ],
  "connections": [
    [ "pir1:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "pir1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pir1:OUT", "esp:D27", "green", [ "v0" ] ],

    [ "btn1:1.l", "esp:D26", "green", [ "v0" ] ],
    [ "btn1:2.l", "esp:GND.1", "black", [ "v0" ] ],

    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:D34", "yellow", [ "v0" ] ],

    [ "matrix1:VDD", "esp:5V", "red", [ "v0" ] ],
    [ "matrix1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "matrix1:DIN", "esp:D5", "green", [ "v0" ] ],

    [ "esp:D25", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:D2", "r2:1", "green", [ "v0" ] ],
    [ "r2:2", "led2:A", "green", [ "v0" ] ],
    [ "led2:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "bz1:1", "esp:GND.2", "black", [ "v0" ] ],
    [ "bz1:2", "esp:D33", "green", [ "v0" ] ],

    [ "servo1:GND", "esp:GND.3", "black", [ "v0" ] ],
    [ "servo1:V+", "esp:5V", "red", [ "v0" ] ],
    [ "servo1:PWM", "esp:D32", "orange", [ "v0" ] ]
  ],
  "dependencies": {}
